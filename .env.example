# ====================================
# SERVER CONFIGURATION
# ====================================
NODE_ENV=development
PORT=3000
HOST=localhost

# ====================================
# CORS CONFIGURATION
# ====================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ====================================
# SECURITY
# ====================================
# JWT Configuration (when authentication is implemented)
# JWT_SECRET=change-this-to-a-strong-random-secret
# JWT_EXPIRATION=3600

# ====================================
# RATE LIMITING
# ====================================
# Time to live in seconds
THROTTLE_TTL=60
# Maximum number of requests within TTL
THROTTLE_LIMIT=10

# ====================================
# LOGGING
# ====================================
# Options: error, warn, info, debug, verbose
LOG_LEVEL=debug

# ====================================
# DATABASE (when implemented)
# ====================================
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=user
# DATABASE_PASSWORD=password
# DATABASE_NAME=dbname
# DATABASE_SYNCHRONIZE=false
# DATABASE_LOGGING=false

# ====================================
# REDIS (when implemented)
# ====================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ====================================
# EMAIL (when implemented)
# ====================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASSWORD=password
# SMTP_FROM=noreply@example.com

# ====================================
# EXTERNAL SERVICES (when implemented)
# ====================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=

# ====================================
# MONITORING & OBSERVABILITY
# ====================================
# SENTRY_DSN=
# NEW_RELIC_LICENSE_KEY=
